# Copie este arquivo para .env.local e preencha.
# Na Vercel, os mesmos nomes vão em Settings -> Environment Variables.

# Supabase -> Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase -> Project Settings -> API Keys -> anon / publishable
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase -> Project Settings -> API Keys -> service_role
# SEGREDO. Nunca compartilhe, nunca vá para o navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Senha longa e aleatória. A Vercel usa para chamar a rotina diária.
CRON_SECRET=

# Endereço público do site. Em produção a Vercel preenche sozinha;
# só preencha aqui se estiver usando um domínio próprio.
NEXT_PUBLIC_APP_URL=http://localhost:3000
